      created_at: datetime("2026-08-31T17:49:44.969000000+00:00"),
      detail: "guard_completeness: (Project, POST /project): no transition is guarded for the combination 'an exception is thrown AND NOT (ex.getCause() instanceof ConstraintViolationException) AND payload_valid' -- either a real input there matches nothing, or these conditions cannot hold together, which is not decidable from the text alone",
      finding_type: "validation",
      lifecycle_state: "Quarantine",
      m_project: "athena",
      model_id: "athena-core-api",
      name: "validation",
      remedy: "restate the guards as simple threshold comparisons, or confirm joint coverage by review \u2014 this is not assumed (M-17)",
      resolution: "open",
