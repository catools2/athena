UNWIND [
  {
      id: "finding:0d274c5dd54376d0",
      detail: "RecordNotFoundException -> 400 is declared by GlobalExceptionHandler, which is an estate-wide @ControllerAdvice: it applies to every controller, so nothing here says which endpoints can reach the throw. The mapping is recovered and NOT modelled as a transition \u2014 attributing it to all of them would invent rejections that cannot occur. An acceptance criterion naming the endpoint would settle it",
      finding_type: "unmodelled",
      lifecycle_state: "Quarantine",
      m_project: "athena",
      name: "unmodelled",
      remedy: "the source could not model this; recover it upstream or author the missing element",
