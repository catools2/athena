{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The existing JS pages keep working untouched; new work is TS and pages migrate
    // as they are edited rather than in one sweep.
    "allowJs": true,
    "checkJs": false,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src"]
}
