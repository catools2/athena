{
  "id": "onprem-playwrightdashboard",
  "title": "QE :: Playwright Dashboard",
  "variant": "onprem",
  "source": "onprem/PlaywrightDashboard",
  "variables": [],
  "panels": [
    {
      "id": 27,
      "title": "",
      "viz": "text",
      "grid": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "content": "<div style=\"font-family:'Segoe UI',Arial,sans-serif; padding:12px; color:#d8d9da; font-size:13px; line-height:1.8;\">\n\n  <!-- HEADER -->\n  <div style=\"font-size:16px; font-weight:700; color:#ffffff; margin-bottom:12px; padding-bottom:8px; border-bottom:2px solid #4db6ac;\">\n    QE :: Playwright Dashboard &mdash; Guide\n  </div>\n\n  <p style=\"margin-bottom:12px; color:#c8cdd6; font-size:13px;\">\n    This dashboard provides a consolidated view of\n    <strong style=\"color:#fff;\">Playwright automated test coverage</strong>\n    and its growth over time &mdash; tracking how many tests are automated, when they were added,\n    and how they are distributed across functional areas, versions, teams, and priorities.\n  </p>\n\n  <hr style=\"border:none; border-top:1px solid #2a3a3a; margin:14px 0;\"/>\n\n  <!-- VARIABLES -->\n  <div style=\"font-size:14px; font-weight:700; color:#ffffff; margin-bottom:10px;\">\n    Dashboard Filters &amp; Scope\n  </div>\n\n  <div style=\"display:flex; gap:10px; margin-bottom:16px;\">\n\n    <div style=\"flex:1; background:#1e2e2e; border:1px solid #2e4a4a; border-radius:8px; padding:11px 14px; border-top:3px solid #4db6ac;\">\n      <div style=\"font-size:13px; font-weight:700; color:#4db6ac; margin-bottom:4px;\">Time Range</div>\n      <div style=\"font-size:12px; color:#c8cdd6; line-height:1.6;\">\n        Controls the <strong style=\"color:#fff;\">active time window</strong> for all panels. Default is\n        <strong style=\"color:#fff;\">Last 90 days</strong>. Adjust using the Grafana time picker (top-right)\n        to zoom into specific automation periods.\n      </div>\n    </div>\n\n    <div style=\"flex:1; background:#1e2e2e; border:1px solid #2e4a4a; border-radius:8px; padding:11px 14px; border-top:3px solid #a78bfa;\">\n      <div style=\"font-size:13px; font-weight:700; color:#a78bfa; margin-bottom:4px;\">Scope</div>\n      <div style=\"font-size:12px; color:#c8cdd6; line-height:1.6;\">\n        Only tests marked as <strong style=\"color:#fff;\">Playwright Automated</strong> are shown in this\n        dashboard. No other automation types or manual tests are included.\n      </div>\n    </div>\n\n  </div>\n\n</div>",
      "mode": "html"
    },
