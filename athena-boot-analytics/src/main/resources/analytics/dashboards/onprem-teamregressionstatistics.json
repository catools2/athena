{
  "id": "onprem-teamregressionstatistics",
  "title": "QE :: Team Regression Statistics",
  "variant": "onprem",
  "source": "onprem/TeamRegressionStatistics",
  "variables": [
    {
      "name": "version",
      "type": "query",
      "label": "version",
      "multi": false,
      "includeAll": false,
      "queryId": "q283f8e4405"
    },
    {
      "name": "team",
      "type": "query",
      "label": "team",
      "multi": false,
      "includeAll": false,
      "queryId": "q3dbc8005e8"
    },
    {
      "name": "cycle_type",
      "type": "custom",
      "label": "cycle_type",
      "multi": false,
      "includeAll": false,
      "options": [
        "Not LIKE",
        "LIKE"
      ]
    }
  ],
  "panels": [
    {
      "id": 32,
      "title": "",
      "viz": "text",
      "grid": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "content": "<div style=\"font-family:'Segoe UI',Arial,sans-serif; padding:12px; color:#d8d9da; font-size:13px; line-height:1.8;\">\n\n  <p style=\"margin-bottom:12px; color:#c8cdd6; font-size:13px;\">\n    This dashboard provides a <strong style=\"color:#fff;\">comprehensive view of test execution statistics</strong>\n    across manual and automated test cycles. It tracks\n    <strong style=\"color:#2ecc71;\">automation coverage</strong>,\n    <strong style=\"color:#5bb8ff;\">cycle execution status</strong>,\n    <strong style=\"color:#b794f4;\">functional area coverage</strong> and\n    <strong style=\"color:#f5a623;\">label-based coverage</strong>\n    &mdash; supporting quality reporting, sprint planning and audit readiness.\n  </p>\n\n  <hr style=\"border:none; border-top:1px solid #2a2a4a; margin:14px 0;\"/>\n\n  <!-- VARIABLES -->\n  <div style=\"font-size:14px; font-weight:700; color:#ffffff; margin-bottom:10px;\">\n    Dashboard Variables &amp; Filters\n  </div>\n\n<div style=\"display:flex; gap:10px; margin-bottom:16px; align-items:stretch;\">\n\n  <!-- Version -->\n  <div style=\"flex:1; background:#1e2a40; border:1px solid #2e4060; border-radius:8px; padding:11px 14px; border-top:3px solid #5bb8ff;\">\n    <div style=\"font-size:13px; font-weight:700; color:#5bb8ff; margin-bottom:4px;\">Version</div>\n    <div style=\"font-size:12px; color:#c8cdd6; line-height:1.6;\">\n      Select the <strong style=\"color:#fff;\">release or patch version</strong> to scope all results &mdash;\n      e.g. <strong style=\"color:#5bb8ff;\">4.14.0</strong> (release) or <strong style=\"color:#5bb8ff;\">4.13.1</strong> (patch).\n    </div>\n  </div>\n\n  <!-- Team -->\n  <div style=\"flex:1; background:#1e2a40; border:1px solid #2e4060; border-radius:8px; padding:11px 14px; border-top:3px solid #b794f4;\">\n    <div style=\"font-size:13px; font-weight:700; color:#b794f4; margin-bottom:4px;\">Team</div>\n    <div style=\"font-size:12px; color:#c8cdd6; line-height:1.6;\">\n      Filter by <strong style=\"color:#fff;\">team</strong> to view their execution results &mdash;\n      e.g. <strong style=\"color:#b794f4;\">Team A</strong>, <strong style=\"color:#b794f4;\">Team B</strong>, <strong style=\"color:#b794f4;\">Team Alpha</strong>.\n    </div>\n  </div>\n\n  <!-- Cycle Type -->\n  <div style=\"flex:1; background:#1e2a40; border:1px solid #2e4060; border-radius:8px; padding:11px 14px; border-top:3px solid #f5a623;\">\n    <div style=\"font-size:13px; font-weight:700; color:#f5a623; margin-bottom:4px;\">Cycle Type</div>\n    <div style=\"font-size:12px; color:#c8cdd6; line-height:1.6;\">\n      <strong style=\"color:#f5a623;\">SprintRegression</strong> &mdash; regression run during an <strong style=\"color:#fff;\">active sprint</strong>.<br/>\n      <strong style=\"color:#f5a623;\">Regression</strong> &mdash; regression run during a <strong style=\"color:#fff;\">hardening sprint</strong>.\n    </div>\n  </div>\n\n</div>\n\n  <hr style=\"border:none; border-top:1px solid #2a2a4a; margin:14px 0;\"/>\n\n</div>",
      "mode": "html"
    },
