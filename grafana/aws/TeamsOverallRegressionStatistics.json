          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH categorized_cycles AS (\n    SELECT DISTINCT \n        tcs.item_id,\n        tcs.version,\n        execution_status AS status\n    FROM athena.mv_test_cycle_statistics tcs\n    WHERE \n        tcs.cycle_name LIKE '%Regression%' \n        AND tcs.project_code = 'DEMO' \n        AND tcs.version = '$version'\n        AND item_execution_rank = 1\n        AND EXISTS (\n            SELECT 1\n            FROM jsonb_array_elements_text(tcs.teams_set) AS team\n            WHERE team.value IN ($team)\n        )\n)\nSELECT \n    status,\n    COUNT(*) AS count\nFROM categorized_cycles\nGROUP BY status\nORDER BY count DESC;",
