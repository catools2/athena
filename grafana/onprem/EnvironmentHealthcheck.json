            {
              "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "${athena_datasource}"
              },
              "editorMode": "code",
              "format": "table",
              "rawQuery": true,
              "rawSql": "WITH latest_pipeline AS (\r\n  SELECT p.id\r\n  FROM athena_pipeline.pipeline p\r\n  JOIN athena_core.environment env ON p.environment_id = env.id\r\n  LEFT JOIN athena_core.app_version v ON p.version_id = v.id\r\n  LEFT JOIN athena_core.project proj ON v.project_id = proj.id\r\n  WHERE proj.code::text = 'DEMO'::text\r\n      AND p.start_date > (now() - '1 mon'::interval)\r\n      AND p.name::text ~~ 'Monitoring - QA Validation Tests'::text\r\n      AND p.start_date IS NOT null\r\n      AND env.name = '$environment'                -- <--- filter here\r\n  ORDER BY p.start_date DESC\r\n  LIMIT 1\r\n)\r\nSELECT\r\n    COUNT(*) AS count,\r\n    s.name AS status\r\nFROM (\r\n    SELECT DISTINCT ON (e.class_name)\r\n        e.class_name,\r\n        s.name\r\n    FROM athena_pipeline.execution e\r\n    JOIN athena_pipeline.status s ON e.status_id = s.id\r\n    WHERE e.pipeline_id = (SELECT id FROM latest_pipeline)\r\n    ORDER BY e.class_name, e.end_time DESC\r\n) sub\r\nJOIN athena_pipeline.status s ON sub.name = s.name\r\nGROUP BY s.name\r\nORDER BY s.name;\r\n",
              "refId": "A",
              "sql": {
                "columns": [
                  {
                    "parameters": [],
                    "type": "function"
                  }
                ],
                "groupBy": [
                  {
                    "property": {
                      "type": "string"
                    },
                    "type": "groupBy"
                  }
                ],
                "limit": 50
              }
            }
          ],
          "title": "Last Execution Status",
          "type": "piechart"
        },
