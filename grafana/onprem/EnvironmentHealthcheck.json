            {
              "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "${athena_datasource}"
              },
              "editorMode": "code",
              "format": "table",
              "rawQuery": true,
              "rawSql": "WITH latest_pipeline AS (\r\n  SELECT p.id\r\n  FROM athena_pipeline.pipeline p\r\n  JOIN athena_core.environment env ON p.environment_id = env.id\r\n  LEFT JOIN athena_core.app_version v ON p.version_id = v.id\r\n  LEFT JOIN athena_core.project proj ON v.project_id = proj.id\r\n  WHERE proj.code::text = 'DEMO'::text\r\n      AND p.start_date > (now() - '1 mon'::interval)\r\n      AND p.name::text ~~ 'Monitoring - QA Validation Tests'::text\r\n       AND env.name = '$environment'  \r\n      AND p.start_date IS NOT NULL\r\n  ORDER BY p.start_date DESC\r\n  LIMIT 1\r\n)\r\nSELECT DISTINCT ON (e.class_name)\r\n    e.class_name,\r\n    s.name AS STATUS,\r\n    EXTRACT(EPOCH FROM (e.end_time - e.start_time)) AS duration\r\nFROM athena_pipeline.execution e\r\nJOIN athena_pipeline.status s ON e.status_id = s.id\r\nWHERE e.pipeline_id = (SELECT id FROM latest_pipeline)\r\nORDER BY e.class_name, e.end_time DESC;",
              "refId": "A",
              "sql": {
                "columns": [
                  {
                    "parameters": [],
                    "type": "function"
                  }
