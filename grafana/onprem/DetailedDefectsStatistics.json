      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${athena_datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    item_status,\n    COUNT(DISTINCT item_id) AS total\nFROM athena.mv_items i\nLeft Join athena.vw_core_normalized_users vcnu on vcnu.id = i.created_by \nWHERE i.project_code = 'DEMO'\n  AND i.item_type = 'Bug'\n  AND i.created_on between $__timeFrom() and $__timeTo()\n  AND (ARRAY[${reporters}] = ARRAY['__all__'] OR vcnu.username in (${reporters:sqlstring}))\n  AND (ARRAY[${team}] = ARRAY['__all__'] OR i.teams_set ?| ARRAY[${team:sqlstring}])\n  AND (ARRAY[${rcas}] = ARRAY['__all__'] OR i.rca_set ?| ARRAY[${rcas:sqlstring}])\n  AND (ARRAY[${affected_versions}] = ARRAY['__all__'] OR i.affected_version_set ?| ARRAY[${affected_versions:sqlstring}])\nGROUP BY item_status\nOrder by item_status\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Unique Defects By Version",
      "type": "bargauge"
    },
