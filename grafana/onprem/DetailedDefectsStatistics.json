      "id": 86,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "<div style=\"font-family:'Segoe UI',Arial,sans-serif; padding:12px; color:#d8d9da; font-size:13px; line-height:1.8;\">\n\n  <p style=\"margin-bottom:12px; color:#c8cdd6; font-size:13px;\">\n    This dashboard displays the <strong style=\"color:#fff;\">daily bug creation count</strong> for teams in the\n    <strong style=\"color:#fff;\">DEMO project</strong>, showing how many bugs each team created per day over the\n    selected time period. It provides a full breakdown of defects by\n    <strong style=\"color:#5bb8ff;\">version</strong>,\n    <strong style=\"color:#b794f4;\">RCA (Root Cause Analysis)</strong>,\n    <strong style=\"color:#2ecc71;\">functional area</strong> and\n    <strong style=\"color:#f5a623;\">team</strong>\n    &mdash; supporting bug trend analysis, workload planning and quality assurance efforts.\n  </p>\n\n  <hr style=\"border:none; border-top:1px solid #2a2a4a; margin:14px 0;\"/>\n\n  <!-- VARIABLES -->\n  <div style=\"font-size:14px; font-weight:700; color:#ffffff; margin-bottom:10px;\">\n    Dashboard Variables &amp; Filters\n  </div>\n\n  <div style=\"display:flex; gap:10px; margin-bottom:10px; align-items:stretch;\">\n\n    <div style=\"flex:1; background:#1e2a40; border:1px solid #2e4060; border-radius:8px; padding:11px 14px; border-top:3px solid #5bb8ff;\">\n      <div style=\"font-size:13px; font-weight:700; color:#5bb8ff; margin-bottom:4px;\">Team</div>\n      <div style=\"font-size:12px; color:#c8cdd6; line-height:1.6;\">\n        Filter by one or more <strong style=\"color:#fff;\">teams</strong> &mdash; e.g.\n        <strong style=\"color:#5bb8ff;\">SME Team, Team A, Team Alpha, Team B, Team Beta</strong>.\n        Each selected team is shown as a tab. Supports multi-select.\n      </div>\n    </div>\n\n    <div style=\"flex:1; background:#1e2a40; border:1px solid #2e4060; border-radius:8px; padding:11px 14px; border-top:3px solid #b794f4;\">\n      <div style=\"font-size:13px; font-weight:700; color:#b794f4; margin-bottom:4px;\">Affected Versions</div>\n      <div style=\"font-size:12px; color:#c8cdd6; line-height:1.6;\">\n        Filter defects by <strong style=\"color:#fff;\">affected release or patch version</strong> &mdash;\n        e.g. <strong style=\"color:#b794f4;\">3.11, 3.10, 3.71, 3.16, 3.18</strong>. Supports multi-select.\n      </div>\n    </div>\n\n    <div style=\"flex:1; background:#1e2a40; border:1px solid #2e4060; border-radius:8px; padding:11px 14px; border-top:3px solid #f5a623;\">\n      <div style=\"font-size:13px; font-weight:700; color:#f5a623; margin-bottom:4px; text-align:right;\">Time Range</div>\n      <div style=\"font-size:12px; color:#c8cdd6; line-height:1.6; text-align:right;\">\n        Controls the <strong style=\"color:#fff;\">active time window</strong> for all panels.\n        Default is <strong style=\"color:#fff;\">Last 90 days</strong>.\n      </div>\n    </div>\n\n  </div>\n</div>",
        "mode": "html"
      },
